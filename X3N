    local function localKickSelf(reason)
        notifyLocal("N3X Admin", "You have been kicked: " .. (reason or "no reason"), 3)
        task.wait(0.4)
        pcall(function()
            player:Kick("N3X Admin: " .. (reason or "Kicked by admin"))
        end)
