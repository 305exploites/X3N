    local function localFreezeSelf()
        local char = player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root then return end
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.UseJumpPower = true
        if not root:FindFirstChild("N3X_RemoteFreeze") then
            local a = Instance.new("Attachment", root)
            a.Name = "N3X_RemoteFreeze"
            local c = Instance.new("AnchorConstraint", root)
            c.Name = "N3X_RemoteFreezeC"
            c.Attachment0 = a
            c.Enabled = true
        end
        notifyLocal("N3X Admin", "You have been frozen", 2)
    end

    local function localUnfreezeSelf()
        local char = player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = 16
            hum.JumpPower = 50
        end
        for _, d in ipairs(char:GetDescendants()) do
            if d.Name == "N3X_RemoteFreeze" or d.Name == "N3X_RemoteFreezeC" then
                pcall(function() d:Destroy() end)
            end
        end
        notifyLocal("N3X Admin", "You have been unfrozen", 2)
    end

