    local function isAimHeld()
        if aimSettings.HoldKey == "None" then return true end
        if aimSettings.HoldKey == "RightMouse" then
            return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        elseif aimSettings.HoldKey == "LeftAlt" then
            return UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt)
        elseif aimSettings.HoldKey == "E" then
            return UserInputService:IsKeyDown(Enum.KeyCode.E)
        elseif aimSettings.HoldKey == "Q" then
            return UserInputService:IsKeyDown(Enum.KeyCode.Q)
        end
        return true
    end

    local function predictPosition(part)
        if aimSettings.PredictionTime <= 0 then return part.Position end
        local vel = part.AssemblyLinearVelocity or part.Velocity or Vector3.zero
        return part.Position + vel * aimSettings.PredictionTime
    end

    local function startAim()
        if aimConn then aimConn:Disconnect(); aimConn = nil end
        createAimCircle()
        aimConn = RunService.RenderStepped:Connect(function()
            if not settings.AimEnabled or not player.Character then return end
            if not isAimHeld() then
                if aimCircleStroke then
                    aimCircleStroke.Color = Color3.fromRGB(255, 0, 0)
                end
                return
            end

            local plr, part = findBestTarget()
            if part then
                local targetPos = predictPosition(part)
                targetPos = targetPos + Vector3.new(0, aimSettings.VerticalOffset, 0)

                local cam = workspace.CurrentCamera
                local targetCF = CFrame.lookAt(cam.CFrame.Position, targetPos)
                local smooth = 1 - math.clamp(aimSettings.Smoothness, 0, 1)
                if smooth < 0.01 then smooth = 0.01 end
                cam.CFrame = cam.CFrame:Lerp(targetCF, smooth)

                if aimCircleStroke then
                    aimCircleStroke.Color = Color3.fromRGB(0, 255, 0)
                end
            else
                if aimCircleStroke then
                    aimCircleStroke.Color = Color3.fromRGB(255, 0, 0)
                end
            end
        end)
        track(aimConn)
    end

    local function stopAim()
        if aimConn then aimConn:Disconnect(); aimConn = nil end
        if aimCircle then aimCircle:Destroy(); aimCircle = nil; aimCircleStroke = nil end
        lockedTarget = nil
        lockedPart = nil
    end

    local function enableSilentAim()
        if silentAimConn then silentAimConn:Disconnect(); silentAimConn = nil end
        if not aimSettings.SilentAim then return end

        silentAimConn = UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            if not isAimHeld() then return end

            local char = player.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            local tool = char:FindFirstChildWhichIsA("Tool")
            if not tool then return end
            local gunName = tool.Name:lower()
            if not (gunName:find("gun") or gunName:find("pistol") or gunName:find("revolver") or gunName:find("shotgun") or gunName:find("rifle")) then
                return
            end

            local plr, part = findBestTarget()
            if not part then return end
            if aimSettings.SilentHitPart == "Head" then
                local head = part.Parent and part.Parent:FindFirstChild("Head")
                if head then part = head end
            end

            local targetPos = predictPosition(part)
            local cam = workspace.CurrentCamera
            local screenPos, onScreen = cam:WorldToViewportPoint(targetPos)
            if onScreen then
                pcall(function()
                    game:GetService("VirtualInputManager"):SendMouseMoveEvent(screenPos.X, screenPos.Y, Enum.UserInputType.MouseMovement)
                end)
            end
        end)
        track(silentAimConn)
    end

    local function disableSilentAim()
        if silentAimConn then silentAimConn:Disconnect(); silentAimConn = nil end
    end

    local function startAutoFire()
        if autoFireConn then autoFireConn:Disconnect(); autoFireConn = nil end
        if not aimSettings.AutoFire then return end
        autoFireConn = RunService.Heartbeat:Connect(function()
            if not settings.AimEnabled or not aimSettings.AutoFire then return end
            if not player.Character then return end
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            local tool = player.Character:FindFirstChildWhichIsA("Tool")
            if not tool then return end
            local plr, part = findBestTarget()
            if plr and part then
                pcall(function()
                    tool:Activate()
                end)
            end
        end)
        track(autoFireConn)
    end

    local function stopAutoFire()
        if autoFireConn then autoFireConn:Disconnect(); autoFireConn = nil end
    end

