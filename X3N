            return
        end
        autoPickupConn = RunService.Heartbeat:Connect(function()
            if isPickingUp or not player.Character then return end
            local gun = findDroppedGun()
            if gun and not pickedUpGuns[gun] then
                performGrabGun()
            end
        end)
        track(autoPickupConn)
    end

    -- FE Invisibility
    local feInvisOn = false
    local feInvisChair = nil
    local feInvisWeld = nil
    local feOriginalCFrame = nil

    local function feSetTransparency(char, val)
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                p.Transparency = val
            end
        end
    end

    local function findSafeSpot()
        local char = player.Character
        if not char then return nil end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return nil end
        local origin = root.Position
        local offsets = {
            Vector3.new(0, 30, 0),
            Vector3.new(0, 60, 0),
            Vector3.new(0, 100, 0),
            Vector3.new(0, 150, 0),
        }
        for _, off in ipairs(offsets) do
            local candidate = origin + off
            local tooClose = false
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character then
                    local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                    if tRoot and (tRoot.Position - candidate).Magnitude < 40 then
                        tooClose = true
                        break
                    end
                end
            end
            if not tooClose then
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = { char }
                local hit = workspace:Raycast(candidate, Vector3.new(0, -5, 0), params)
                if not hit then
                    return CFrame.new(candidate)
                end
            end
        end
        return CFrame.new(origin + Vector3.new(0, 30, 0))
    end

    local function feToggleInvis()
        local char = player.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        if not feInvisOn then
            feOriginalCFrame = root.CFrame
            local safeCF = findSafeSpot()
            if not safeCF then
                Message("FE Invis", "Couldn't find a safe spot", 2)
                feOriginalCFrame = nil
                return
            end
            root.CFrame = safeCF
            root.Velocity = Vector3.zero
            root.RotVelocity = Vector3.zero
            task.wait(0.25)
            local after = root.Position
            if (after - safeCF.Position).Magnitude > 20 then
                Message("FE Invis", "Safe move rejected by server", 2)
                if feOriginalCFrame then root.CFrame = feOriginalCFrame end
                feOriginalCFrame = nil
                return
            end
            feInvisOn = true
            feSetTransparency(char, 0.5)
            local safePos = root.Position
            feInvisChair = Instance.new("Seat", workspace)
            feInvisChair.Anchored = false
            feInvisChair.CanCollide = false
            feInvisChair.Name = "FE_InvisChair"
            feInvisChair.Transparency = 1
            feInvisChair.Position = safePos
            feInvisWeld = Instance.new("Weld", feInvisChair)
            feInvisWeld.Part0 = feInvisChair
            feInvisWeld.Part1 = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
            Message("FE Invis", "Safe + invisible", 2)
        else
            feSetTransparency(char, 0)
            if feInvisChair then pcall(function() feInvisChair:Destroy() end); feInvisChair = nil end
            if feInvisWeld then pcall(function() feInvisWeld:Destroy() end); feInvisWeld = nil end
            if feOriginalCFrame then
                root.CFrame = feOriginalCFrame
                root.Velocity = Vector3.zero
                root.RotVelocity = Vector3.zero
            end
            feOriginalCFrame = nil
            feInvisOn = false
            Message("FE Invis", "Restored", 2)
        end
    end

    -- KILL ALL
    local killAllPositions = {}
    local killAllConnection = nil
    local killAllWeaponHideConn = nil
    local hiddenWeapons = {}

    local function hideWeaponsOnAllPlayers()
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                for _, tool in ipairs(plr.Character:GetChildren()) do
                    if tool:IsA("Tool") then
                        local n = tool.Name:lower()
                        if n:find("knife") or n:find("gun") or n:find("pistol") or n:find("revolver") or n:find("shotgun") then
                            if not hiddenWeapons[tool] then
                                local saved = {}
                                for _, part in ipairs(tool:GetDescendants()) do
                                    if part:IsA("BasePart") then
                                        saved[part] = part.Transparency
                                        part.Transparency = 1
                                    end
                                end
                                hiddenWeapons[tool] = saved
                            end
                        end
                    end
                end
            end
        end
    end

    local function restoreHiddenWeapons()
        for tool, saved in pairs(hiddenWeapons) do
            if tool and tool.Parent then
                for part, trans in pairs(saved) do
                    if part and part.Parent then
                        part.Transparency = trans
                    end
                end
            end
        end
        hiddenWeapons = {}
    end

    local function savePlayerPositions()
        killAllPositions = {}
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                local root = plr.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    killAllPositions[plr.UserId] = root.CFrame
                end
            end
        end
    end

    local function restoreAllPlayers()
        for userId, cf in pairs(killAllPositions) do
            local plr = Players:GetPlayerByUserId(userId)
            if plr and plr.Character then
                local root = plr.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    root.CFrame = cf
                    root.Velocity = Vector3.zero
                    root.RotVelocity = Vector3.zero
                end
                for _, part in ipairs(plr.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Transparency = 0
                        part.CanCollide = true
                    end
                end
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.HealthDisplayDistance = 100
                    hum.NameDisplayDistance = 100
                end
            end
        end
        killAllPositions = {}
        restoreHiddenWeapons()
        if settings.ESPEnabled then pcall(refreshESP) end
        if settings.NameTagESP then pcall(refreshNameTags) end
    end

    local function pullAllOnce()
        if not player.Character then return end
        local localRoot = player.Character:FindFirstChild("HumanoidRootPart")
        if not localRoot then return end
        local targetPos = localRoot.Position + localRoot.CFrame.LookVector * 3
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                local char = plr.Character
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    if not killAllPositions[plr.UserId] then
                        killAllPositions[plr.UserId] = root.CFrame
                    end
                    root.CFrame = CFrame.new(targetPos)
                    root.Velocity = Vector3.zero
                    root.RotVelocity = Vector3.zero
                end
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Transparency = 1
                        part.CanCollide = false
                    end
                end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.HealthDisplayDistance = 0
                    hum.NameDisplayDistance = 0
                end
            end
        end
        hideWeaponsOnAllPlayers()
    end

    local function startKillAllLoop()
        if killAllConnection then killAllConnection:Disconnect(); killAllConnection = nil end
        savePlayerPositions()
        hideWeaponsOnAllPlayers()
        killAllConnection = RunService.Heartbeat:Connect(function()
            if not settings.KillAllOn or not player.Character then return end
            pullAllOnce()
        end)
        track(killAllConnection)
        if killAllWeaponHideConn then killAllWeaponHideConn:Disconnect() end
        killAllWeaponHideConn = RunService.Heartbeat:Connect(function()
            if not settings.KillAllOn then return end
            hideWeaponsOnAllPlayers()
        end)
        track(killAllWeaponHideConn)
        Message("Kill All", "Loop started (weapons hidden)", 2)
    end

    local function stopKillAllLoop()
        if killAllConnection then killAllConnection:Disconnect(); killAllConnection = nil end
