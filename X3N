    -- ROLE DETECTION
    local function hasKnife(plr)
        if not plr then return false end
        local containers = {}
        if plr.Character then table.insert(containers, plr.Character) end
        local bp = plr:FindFirstChild("Backpack")
        if bp then table.insert(containers, bp) end
        for _, c in ipairs(containers) do
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and t.Name:lower():find("knife") then
                    return true
                end
            end
        end
        return false
    end

    local function hasGun(plr)
        if not plr then return false end
        local containers = {}
        if plr.Character then table.insert(containers, plr.Character) end
        local bp = plr:FindFirstChild("Backpack")
        if bp then table.insert(containers, bp) end
        for _, c in ipairs(containers) do
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") then
                    local n = t.Name:lower()
                    if n:find("gun") or n:find("pistol") or n:find("revolver") or n:find("shotgun") then
                        return true
                    end
                end
            end
        end
        return false
    end

    local function getRoleFromLabel(plr)
        local pg = plr:FindFirstChild("PlayerGui")
        if not pg then return nil end
        for _, d in ipairs(pg:GetDescendants()) do
            if d:IsA("TextLabel") then
                local t = (d.Text or ""):lower()
                if t:find("murder") then return "Murderer" end
                if t:find("sheriff") then return "Sheriff" end
                if t:find("innocent") then return "Innocent" end
            end
        end
        return nil
    end

    local function getPlayerRole(plr)
        if not plr then return "Innocent" end
        if hasKnife(plr) then return "Murderer" end
        if hasGun(plr) then return "Sheriff" end
        local fromLabel = getRoleFromLabel(plr)
        if fromLabel then return fromLabel end
        return "Innocent"
    end

    local function getRoleColor(plr)
        local r = getPlayerRole(plr)
        if r == "Murderer" then return COLORS.murderer end
        if r == "Sheriff" then return COLORS.sheriff end
        return COLORS.innocent
    end

