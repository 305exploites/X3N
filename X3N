    local silentAimConn = nil
    local aimCircle = nil
    local aimCircleStroke = nil
    local lockedTarget = nil
    local lockedPart = nil
    local lastLockTime = 0
    local autoFireConn = nil

    local aimSettings = {
        TargetPart = "Head",
        RoleFilter = "All",
        WallCheck = true,
        VisibleCheck = true,
        StickyTarget = true,
        StickyTime = 0.5,
        Smoothness = 0.5,
        FOV = 50,
        PredictionTime = 0.08,
        VerticalOffset = 0,
