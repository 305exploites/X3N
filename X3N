    local existing = playerGui:FindFirstChild("N3X_AimbotGui")
    if existing then
        existing.Enabled = true
        existing.DisplayOrder = 999
        local mainFrame = existing:FindFirstChild("MainFrame")
        if mainFrame then mainFrame.Visible = true end
        warn("[N3X] Silent Aim GUI already loaded — keeping existing instance.")
        return
    end
end

