    local function freezePlayer(target)
        if not target or not target.Character then
            Message("Admin", "Target has no character", 2)
            return
        end
        if frozenPlayers[target] then
            Message("Admin", target.DisplayName .. " is already frozen", 2)
            return
        end
        local char = target.Character
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root then
            Message("Admin", "Target missing humanoid/root", 2)
            return
        end
        frozenPlayers[target] = true
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.UseJumpPower = true
        local anchor = Instance.new("AnchorConstraint")
        anchor.Name = "N3X_Freeze"
        anchor.Parent = root
        anchor.Attachment0 = Instance.new("Attachment", root)
        anchor.Enabled = true
        frozenConnections[target] = anchor
        Message("Admin", "Froze " .. target.DisplayName, 2)
    end

    local function unfreezePlayer(target)
        if not target then return end
        if not frozenPlayers[target] then
            Message("Admin", target.DisplayName .. " is not frozen", 2)
            return
        end
        frozenPlayers[target] = nil
        if target.Character then
            local hum = target.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = 16
                hum.JumpPower = 50
                hum.UseJumpPower = true
            end
            local anchor = target.Character:FindFirstChild("N3X_Freeze", true)
            if anchor then anchor:Destroy() end
        end
        if frozenConnections[target] then
            pcall(function() frozenConnections[target]:Destroy() end)
            frozenConnections[target] = nil
        end
        Message("Admin", "Unfroze " .. target.DisplayName, 2)
    end

    local function toggleFreeze(target)
        if frozenPlayers[target] then
            unfreezePlayer(target)
        else
            freezePlayer(target)
        end
    end

    -- Anti-Fling Backfire
    local antiFlingBackfireEnabled = false
    local antiFlingBackfireConn = nil
    local flingDetectCooldown = 0

    local function startAntiFlingBackfire()
        if antiFlingBackfireConn then antiFlingBackfireConn:Disconnect(); antiFlingBackfireConn = nil end
        antiFlingBackfireEnabled = true
        local lastPos = nil
        antiFlingBackfireConn = RunService.Heartbeat:Connect(function()
            if not antiFlingBackfireEnabled then return end
            if not player.Character then return end
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if not root then return end

            if root.Velocity.Magnitude > 100 or root.RotVelocity.Magnitude > 100 then
                local nearest = nil
                local nearestDist = math.huge
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= player and plr.Character then
                        local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                        if tRoot then
                            local d = (tRoot.Position - root.Position).Magnitude
                            if d < nearestDist then
                                nearestDist = d
                                nearest = plr
                            end
                        end
                    end
                end

                root.Velocity = Vector3.zero
                root.RotVelocity = Vector3.zero
                if lastPos then root.CFrame = lastPos end

                if nearest and nearestDist < 50 and tick() - flingDetectCooldown > 1 then
                    flingDetectCooldown = tick()
                    Message("Anti-Fling", "Backfiring on " .. nearest.DisplayName, 2)
                    task.spawn(function()
                        local tRoot = nearest.Character and nearest.Character:FindFirstChild("HumanoidRootPart")
                        if tRoot then
                            for i = 1, 20 do
                                if not tRoot or not tRoot.Parent then break end
                                tRoot.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
                                tRoot.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                                task.wait()
                            end
                        end
                    end)
                end
            else
                lastPos = root.Position
            end
        end)
        track(antiFlingBackfireConn)
    end

    local function stopAntiFlingBackfire()
        antiFlingBackfireEnabled = false
        if antiFlingBackfireConn then antiFlingBackfireConn:Disconnect(); antiFlingBackfireConn = nil end
    end

    local function bringPlayer(target)
        if not target or not target.Character then
            Message("Admin", "Target has no character", 2)
            return
        end
        if not player.Character then return end
        local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
        local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
        if myRoot and tRoot then
            tRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, 3)
            tRoot.Velocity = Vector3.zero
            Message("Admin", "Brought " .. target.DisplayName, 2)
        end
    end

    local function gotoPlayer(target)
        if not target or not target.Character then
            Message("Admin", "Target has no character", 2)
            return
        end
        if not player.Character then return end
        local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
        local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
        if myRoot and tRoot then
            myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
            myRoot.Velocity = Vector3.zero
            Message("Admin", "Teleported to " .. target.DisplayName, 2)
        end
    end

    local function kickPlayer(target)
        if not target then return end
        if target == player then
            Message("Admin", "You can't kick yourself", 2)
            return
        end
        Message("Admin", "Kicking " .. target.DisplayName .. " (client-side)", 2)
        if target.Character then
            target.Character:Destroy()
        end
    end

    local function slapPlayer(target)
        if not target or not target.Character then
            Message("Admin", "Target has no character", 2)
            return
        end
        local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
        if tRoot then
            tRoot.Velocity = Vector3.new(0, 500, 0)
            Message("Admin", "Slapped " .. target.DisplayName, 2)
        end
    end

