    function updateHandlePosition()
        if handleUserMoved then return end

        if not isOpen then
            local vp = workspace.CurrentCamera.ViewportSize
            local y = MainFame.AbsolutePosition.Y + (MainFame.AbsoluteSize.Y - handleGroup.AbsoluteSize.Y) / 2
            handleGroup.Position = UDim2.new(0, 10, 0, y)
            return
        end

        local guiPos = MainFame.AbsolutePosition
        local guiSize = MainFame.AbsoluteSize
        local vp = workspace.CurrentCamera.ViewportSize
        local hSize = handleGroup.AbsoluteSize

        local rightX = guiPos.X + guiSize.X + 8
        local targetX
        if rightX + hSize.X < vp.X then
            targetX = rightX
        else
            targetX = guiPos.X - hSize.X - 8
        end
        local targetY = guiPos.Y + (guiSize.Y - hSize.Y) / 2

        handleGroup.Position = UDim2.new(0, targetX, 0, targetY)
    end

