    -- ========================================================
    -- ANTI-FLING (reflect flings back at the attacker)
    -- Tracks who is near us and flinging; if our velocity spikes
    -- unnaturally, we fling them back.
    -- ========================================================
    local attackerCache = {}   -- [player] = lastSeenTime
    local recentAttackers = {} -- ordered list

    local function rememberAttacker(plr, dist)
        if dist > 15 then return end
        attackerCache[plr] = tick()
        table.insert(recentAttackers, plr)
        if #recentAttackers > 10 then
            table.remove(recentAttackers, 1)
        end
    end

    local function getRecentAttacker()
        local now = tick()
        for i = #recentAttackers, 1, -1 do
            local p = recentAttackers[i]
            if not p or not p.Parent then
                table.remove(recentAttackers, i)
            elseif now - (attackerCache[p] or 0) > 1.0 then
                table.remove(recentAttackers, i)
            else
                return p
            end
        end
        return nil
    end

    -- Keep our own anti-fling running; reflect by flinging the attacker
    antiFlingConn = RunService.Heartbeat:Connect(function()
        if not antiFlingActive then return end
        local root = getRoot()
        local hum = getHumanoid()
        if not root or not hum then return end

        -- Track nearby players as potential attackers
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local pRoot = p.Character:FindFirstChild("HumanoidRootPart")
                if pRoot then
                    local d = (pRoot.Position - root.Position).Magnitude
                    if d < 15 then
                        rememberAttacker(p, d)
                    end
                end
            end
        end

        -- Detect unnatural velocity (fling signature)
        local v = root.Velocity
        if v.Magnitude > 120 or root.RotVelocity.Magnitude > 100 then
            local attacker = getRecentAttacker()
            if attacker and attacker.Character then
                -- Save our position, snap back, then fling them
                if lastSafePos then
                    root.CFrame = lastSafePos
                end
                root.Velocity = Vector3.zero
                root.RotVelocity = Vector3.zero

                -- Fling the attacker
                task.spawn(function()
                    local tChar = attacker.Character
                    if tChar then
                        local tHum = tChar:FindFirstChildOfClass("Humanoid")
                        local tRoot = tHum and tHum.RootPart
                        if tRoot then
                            local myChar = player.Character
                            local myHum = getHumanoid()
                            local myRoot = getRoot()
                            if myChar and myHum and myRoot then
                                local bv = Instance.new("BodyVelocity")
                                bv.Parent = myRoot
                                bv.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
                                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                                local saved = myRoot.CFrame
                                for _ = 1, 6 do
                                    if not myRoot.Parent or not tRoot.Parent then break end
                                    myRoot.CFrame = CFrame.new(tRoot.Position) * CFrame.new(0, 1.5, 0)
                                    myRoot.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
                                    myRoot.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                                    task.wait()
                                end
                                if bv then bv:Destroy() end
                                if myRoot.Parent then
                                    myRoot.CFrame = saved
                                    myRoot.Velocity = Vector3.zero
                                    myRoot.RotVelocity = Vector3.zero
                                    myHum:ChangeState(Enum.HumanoidStateType.GettingUp)
                                end
                            end
                        end
                    end
                    notify("Anti-fling: reflected at " .. attacker.Name, 3)
                end)
            else
                -- No attacker found: just snap back
                if lastSafePos then
                    root.CFrame = lastSafePos
                end
                root.Velocity = Vector3.zero
                root.RotVelocity = Vector3.zero
            end
        else
            lastSafePos = root.CFrame
        end
    end)

    -- ========================================================
    -- Public API (for use from other scripts)
    -- ========================================================
    AdminSystem.isAdmin = isAdmin
    AdminSystem.isAdminLocal = isAdminLocal
    AdminSystem.freezeSelf = freezeSelf
