            local t = TweenService:Create(MainFame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = savedPosition
            })
            t:Play()
            TweenService:Create(ToggleIcon, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Rotation = 180
            }):Play()
            local conn
            conn = RunService.RenderStepped:Connect(function()
                updateHandlePosition()
            end)
            t.Completed:Connect(function()
                if conn then conn:Disconnect() end
                updateHandlePosition()
            end)
        else
            savedPosition = MainFame.Position
            local closedPos = UDim2.new(-0.6, 0, savedPosition.Y.Scale, savedPosition.Y.Offset)
            local t = TweenService:Create(MainFame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                Position = closedPos
            })
            t:Play()
            TweenService:Create(ToggleIcon, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                Rotation = 0
            }):Play()
            local conn
            conn = RunService.RenderStepped:Connect(function()
