    -- ========================================================
    -- TELEPORTS
    -- ========================================================
    local function tpTo(targetPlr)
        if not targetPlr or targetPlr == player then return end
        local myRoot = getRoot()
        local tChar = targetPlr.Character
        if not myRoot or not tChar then return end
        local tRoot = tChar:FindFirstChild("HumanoidRootPart")
        if not tRoot then return end
        myRoot.CFrame = CFrame.new(tRoot.Position + tRoot.CFrame.LookVector * -3)
    end

    local function bringToMe(targetPlr)
        if not targetPlr or targetPlr == player then return end
        local myRoot = getRoot()
        local tChar = targetPlr.Character
        if not myRoot or not tChar then return end
        local tRoot = tChar:FindFirstChild("HumanoidRootPart")
        if not tRoot then return end
        -- We can only move ourselves reliably; move ourselves to them
        -- (for actual "bring" the target client must run it themselves)
        tRoot.CFrame = CFrame.new(myRoot.Position + myRoot.CFrame.LookVector * 3)
        tRoot.Velocity = Vector3.zero
    end

    -- ========================================================
    -- ADMIN COMMAND HANDLER (runs on EVERY client)
    -- Each client reads chat; if admin issued a command and it
    -- names them, they execute on themselves.
    -- ========================================================
    local function handleCommand(speaker, message)
        if not isAdmin(speaker) then return end
        if not message:sub(1, 1) == "/" then return end
        if message:sub(1, 1) ~= "/" then return end

        -- Parse
        local parts = {}
        for word in message:gmatch("%S+") do
            table.insert(parts, word)
        end
        if #parts == 0 then return end

        local cmd = parts[1]:lower():sub(2)  -- strip "/"
        local targetName = parts[2]
        local arg1 = parts[3]
        local arg2 = parts[4]

        -- ====================================================
        -- Commands that always run locally on the LOCAL player
        -- (they act on the LOCAL player, e.g. /tp me bob)
        -- ====================================================
        if cmd == "tp" and targetName and targetName:lower() == "me" then
            local t = findTarget(arg1)
            if t then tpTo(t) end
            return
        end
        if cmd == "goto" then
            local t = findTarget(targetName)
            if t then tpTo(t) end
            return
        end
        if cmd == "help" then
            notify("/kick, /freeze, /unfreeze, /tp, /tp me, /tp all, /goto, /slap, /fling, /speed, /jump, /god, /ungod, /ff, /respawn, /notify, /list", 8)
            return
        end
        if cmd == "list" then
            local names = {}
            for _, p in ipairs(Players:GetPlayers()) do
                table.insert(names, p.Name)
            end
            notify("Players: " .. table.concat(names, ", "), 6)
            return
        end

        -- ====================================================
        -- /tp all  →  every script client TPs to the admin
        -- (the admin's own client does nothing here since they
        --  aren't moving to themselves; other clients move.)
        -- ====================================================
        if cmd == "tp" and targetName and targetName:lower() == "all" then
            if player ~= speaker then
                tpTo(speaker)
            end
            return
        end

        -- ====================================================
        -- Commands targeting another player
        -- Each client only runs if THEY are the target.
        -- ====================================================
        if not targetName then return end

        local targetPlr = findTarget(targetName)
        if not targetPlr then
            -- If admin's own client, tell them the target doesn't exist
            if player == speaker then
                notify("Player not found: " .. tostring(targetName), 3)
            end
            return
        end

        -- The local client only executes if it IS the target
        local iAmTarget = (targetPlr == player)
        -- The admin's client also runs for /bring, /tp-to-me, /notify
        local iAmAdmin = (player == speaker)

        if cmd == "kick" then
            if iAmTarget then
                player:Kick("[N3X Admin] Kicked by " .. speaker.Name)
            elseif iAmAdmin then
                notify("Kick command sent to " .. targetPlr.Name, 3)
            end
            return
        end

        if cmd == "freeze" then
            if iAmTarget then
                freezeSelf()
                notify("You have been frozen by " .. speaker.Name, 3)
            elseif iAmAdmin then
                notify(targetPlr.Name .. " has been frozen", 3)
            end
            return
        end

        if cmd == "unfreeze" then
            if iAmTarget then
                unfreezeSelf()
                notify("You have been unfrozen", 3)
            elseif iAmAdmin then
                notify(targetPlr.Name .. " unfrozen", 3)
            end
            return
        end

        if cmd == "tp" then
            -- /tp <user>  → target TPs to admin
            if iAmTarget then
                tpTo(speaker)
                notify("Teleported to " .. speaker.Name, 3)
            elseif iAmAdmin then
                notify(targetPlr.Name .. " teleported to you", 3)
            end
            return
        end

        if cmd == "bring" then
            -- /bring <user>  → target comes to admin
            if iAmTarget then
                tpTo(speaker)
                notify("Brought to " .. speaker.Name, 3)
            elseif iAmAdmin then
                notify("Bringing " .. targetPlr.Name, 3)
            end
            return
        end

        if cmd == "slap" then
            if iAmTarget then
                slapSelf()
                notify("You have been slapped by " .. speaker.Name, 3)
            elseif iAmAdmin then
                notify("Slapped " .. targetPlr.Name, 3)
            end
            return
        end

        if cmd == "fling" then
            if iAmTarget then
                local tChar = speaker.Character
                if tChar then
                    flingCharacter(tChar)
                end
                notify("You have been flung by " .. speaker.Name, 3)
            elseif iAmAdmin then
                notify("Flung " .. targetPlr.Name, 3)
            end
            return
        end

        if cmd == "speed" then
            local n = tonumber(arg1) or 16
            if iAmTarget then
                setSpeed(n)
                notify("Your speed was set to " .. n, 3)
            elseif iAmAdmin then
                notify(targetPlr.Name .. " speed: " .. n, 3)
            end
            return
        end

        if cmd == "jump" then
            local n = tonumber(arg1) or 50
            if iAmTarget then
                setJump(n)
                notify("Your jump was set to " .. n, 3)
            elseif iAmAdmin then
                notify(targetPlr.Name .. " jump: " .. n, 3)
            end
            return
        end

        if cmd == "god" then
            if iAmTarget then
                godSelf()
                notify("You have been given godmode by " .. speaker.Name, 3)
            elseif iAmAdmin then
                notify(targetPlr.Name .. " given godmode", 3)
            end
            return
        end

        if cmd == "ungod" then
            if iAmTarget then
                ungodSelf()
                notify("Godmode removed", 3)
            elseif iAmAdmin then
                notify(targetPlr.Name .. " godmode removed", 3)
            end
            return
        end

        if cmd == "ff" then
            if iAmTarget then
                giveForcefield()
                notify("You have been given a forcefield", 3)
            elseif iAmAdmin then
                notify(targetPlr.Name .. " forcefield applied", 3)
            end
            return
        end

        if cmd == "respawn" then
            if iAmTarget then
                local hum = getHumanoid()
                if hum then hum.Health = 0 end
            elseif iAmAdmin then
                notify("Respawned " .. targetPlr.Name, 3)
            end
            return
        end

        if cmd == "notify" then
            -- /notify <user> <msg...>
            local msgParts = {}
            for i = 3, #parts do table.insert(msgParts, parts[i]) end
            local msg = table.concat(msgParts, " ")
            if iAmTarget then
                notify(msg, 5)
            elseif iAmAdmin then
                notify("Notify sent to " .. targetPlr.Name, 3)
            end
            return
        end
    end

    -- Chat hook: listens to every player's messages
    player.Chatted:Connect(function(message)
