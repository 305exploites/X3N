    }

    local function hasLineOfSight(targetPart)
        if not aimSettings.WallCheck then return true end
        local cam = workspace.CurrentCamera
        local origin = cam.CFrame.Position
        local dir = (targetPart.Position - origin)
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = { player.Character }
        local result = workspace:Raycast(origin, dir, rayParams)
        if not result then return true end
        if result.Instance == targetPart then return true end
        if result.Instance:IsDescendantOf(targetPart.Parent) then return true end
        return false
    end

    local function isPlayerValid(plr)
        if not plr or plr == player then return false end
        local char = plr.Character
        if not char then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        if aimSettings.RoleFilter ~= "All" then
            local role = getPlayerRole(plr)
            if role ~= aimSettings.RoleFilter then return false end
        end
        if aimSettings.VisibleCheck then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Transparency < 1 then
                    return true
                end
            end
            return false
        end
        return true
    end

    local function getAimPart(plr)
        local char = plr.Character
        if not char then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return nil end

        if aimSettings.TargetPart == "Head" then
            return char:FindFirstChild("Head")
        elseif aimSettings.TargetPart == "Torso" then
            return hum.RootPart or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        elseif aimSettings.TargetPart == "Nearest" then
            local camPos = workspace.CurrentCamera.CFrame.Position
            local best, bestDist = nil, math.huge
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    local d = (part.Position - camPos).Magnitude
                    if d < bestDist then bestDist = d; best = part end
                end
            end
            return best or hum.RootPart
        elseif aimSettings.TargetPart == "Random" then
            local parts = {}
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then table.insert(parts, part) end
            end
            return #parts > 0 and parts[math.random(1, #parts)] or hum.RootPart
        end
        return char:FindFirstChild("Head")
    end

    local function findBestTarget()
        if not player.Character then return nil, nil end
        local cam = workspace.CurrentCamera
        local screenCenter = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)

        if aimSettings.StickyTarget and lockedTarget and lockedPart then
            if isPlayerValid(lockedTarget) and lockedPart.Parent then
                local pos, onScreen = cam:WorldToViewportPoint(lockedPart.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                    if dist <= aimSettings.FOV and hasLineOfSight(lockedPart) then
                        return lockedTarget, lockedPart
                    end
                end
            end
            if tick() - lastLockTime > aimSettings.StickyTime then
                lockedTarget = nil
                lockedPart = nil
            end
        end

        local bestPlr, bestPart, bestScore = nil, nil, -math.huge

        for _, plr in ipairs(Players:GetPlayers()) do
            if isPlayerValid(plr) then
                local part = getAimPart(plr)
                if part then
                    local pos, onScreen = cam:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                        if dist <= aimSettings.FOV then
                            if hasLineOfSight(part) then
                                local role = getPlayerRole(plr)
                                local roleBonus = 0
                                if role == "Murderer" then roleBonus = 300
                                elseif role == "Sheriff" then roleBonus = 150
                                end
                                local score = roleBonus - dist
                                if score > bestScore then
                                    bestScore = score
                                    bestPlr = plr
                                    bestPart = part
                                end
                            end
                        end
                    end
                end
            end
        end

        if bestPlr then
            lockedTarget = bestPlr
            lockedPart = bestPart
            lastLockTime = tick()
        end
        return bestPlr, bestPart
    end

    local function createAimCircle()
