-- ============================================================
-- N3X Fake Bomb Jump Plugin
-- New GUI, styled to match N3X theme
-- Auto-detects equipped FakeBomb — button just PLACES it.
-- Credits: @Kenzie (original), restyled for N3X
-- ============================================================

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService  = game:GetService("UserInputService")
local TweenService      = game:GetService("TweenService")
local RunService        = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local playerGui   = LocalPlayer:WaitForChild("PlayerGui")

-- ============================================================
-- THEME (kept so nothing else changes)
-- ============================================================
local PINK   = Color3.fromRGB(255, 114, 135)
local TEXT   = Color3.fromRGB(255, 210, 220)
local DARK   = Color3.fromRGB(33, 0, 0)
local BG     = Color3.fromRGB(48, 3, 3)
local BG_HDR = Color3.fromRGB(33, 0, 0)
local STROKE = Color3.fromRGB(120, 40, 50)
local ON_C   = Color3.fromRGB(255, 114, 135)
local OFF_C  = Color3.fromRGB(90, 30, 40)
local FONT   = Enum.Font.Garamond

-- ============================================================
-- STATE
-- ============================================================
local onCooldown     = false
local COOLDOWN_TIME  = 24
local cooldownThread = nil
local bombEquipped   = false

-- ============================================================
-- HELPERS (unchanged)
-- ============================================================
local function setStatus(txt) print("[N3X] " .. txt) end

local function getCenterPosition()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local cam = workspace.CurrentCamera
    local camDir = cam.CFrame.LookVector
    local pos = hrp.Position + (camDir * 5)
    local look = camDir
    local right = Vector3.new(0, 1, 0):Cross(look)
    local up = look:Cross(right)
    return CFrame.new(
        pos.X, pos.Y, pos.Z,
        right.X, up.X, look.X,
        right.Y, up.Y, look.Y,
        right.Z, up.Z, look.Z
    )
end

local function makeCharacterJump()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end

local function findFakeBomb()
    local char = LocalPlayer.Character
    if not char then return nil end
    local tool = char:FindFirstChild("FakeBomb")
    if tool and tool:IsA("Tool") then return tool end
    return nil
end

-- ============================================================
-- COOLDOWN (unchanged)
-- ============================================================
local function resetCooldown()
    onCooldown = false
    if cooldownThread then
        task.cancel(cooldownThread)
        cooldownThread = nil
    end
end

local function startCooldown()
    onCooldown = true
    if cooldownThread then task.cancel(cooldownThread); cooldownThread = nil end
    cooldownThread = task.spawn(function()
        for i = COOLDOWN_TIME, 1, -1 do
            if not onCooldown then return end
            setStatus("Cooldown: " .. i .. "s")
            task.wait(1)
        end
        if onCooldown then
            resetCooldown()
        end
    end)
end

-- ============================================================
-- AUTO-DETECT (unchanged)
-- ============================================================
local function syncUI()
    if onCooldown then return end
    bombEquipped = findFakeBomb() ~= nil
    if bombEquipped then
        setStatus("Equipped — ready to place")
    else
        setStatus("Waiting for bomb...")
    end
end

local function watchCharacter(char)
    if not char then return end
    char.ChildAdded:Connect(function(c)
        if c:IsA("Tool") and c.Name == "FakeBomb" then
            task.wait(0.05)
            syncUI()
        end
    end)
    char.ChildRemoved:Connect(function(c)
        if c:IsA("Tool") and c.Name == "FakeBomb" then
            task.wait(0.05)
            syncUI()
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    resetCooldown()
    task.wait(0.5)
    watchCharacter(char)
    syncUI()
end)

if LocalPlayer.Character then
    watchCharacter(LocalPlayer.Character)
end

task.spawn(function()
    while true do
        if not onCooldown then
            local wasEquipped = bombEquipped
            local nowEquipped = findFakeBomb() ~= nil
            if nowEquipped ~= wasEquipped then
                syncUI()
            end
        end
        task.wait(0.5)
    end
end)

-- ============================================================
-- PLACE (this is the exact same body as the old MouseButton1Click)
-- ============================================================
local function onPlace()
    if onCooldown then return end
    if not bombEquipped then
        syncUI()
        return
    end

    local bomb = findFakeBomb()
    if not bomb then
        syncUI()
        return
    end

    local remote = bomb:FindFirstChild("Remote")
    if not remote then
        remote = bomb:FindFirstChild("Events") and bomb.Events:FindFirstChild("Remote")
    end
    if not remote then
        setStatus("Remote not found on tool")
        return
    end

    local cf = getCenterPosition()
    if not cf then
        setStatus("No character")
        return
    end

    pcall(function()
        remote:FireServer(cf, 50)
    end)

    makeCharacterJump()
    startCooldown()
end

-- ============================================================
-- TRIGGER (replaces the GUI button)
-- ============================================================
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.E then
        onPlace()
    end
end)

-- ============================================================
-- DEATH HOOK (unchanged)
-- ============================================================
local function hookChar(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        hum.Died:Connect(function()
            resetCooldown()
            syncUI()
        end)
    end
end

LocalPlayer.CharacterAdded:Connect(function(char)
    hookChar(char)
end)

if LocalPlayer.Character then
    hookChar(LocalPlayer.Character)
end

syncUI()

print("[N3X] Fake Bomb Jump loaded (headless). Press E to place.")
print("Credits: @Kenzie (original)")
