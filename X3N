        return Row
    end

    local function addPlayer(player)
        if rowCache[player] then return end
        local row = createRow(player, #Players:GetPlayers())
        row.Parent = PlayerList
        rowCache[player] = row
        Count.Text = tostring(#Players:GetPlayers())
        reorderRows()
        if expanded then setExpanded(true) end
    end

    local function removePlayer(player)
        local row = rowCache[player]
        if row then
            row:Destroy()
            rowCache[player] = nil
        end
        pinned[player] = nil
        Count.Text = tostring(#Players:GetPlayers())
        reorderRows()
        if expanded then setExpanded(true) end
    end

    Players.PlayerAdded:Connect(addPlayer)
    Players.PlayerRemoving:Connect(removePlayer)

    for _, player in ipairs(Players:GetPlayers()) do
        addPlayer(player)
    end

    local listLayout = PlayerList:FindFirstChildOfClass("UIListLayout")
    if listLayout then
        local function updateCanvas()
            PlayerList.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 14)
        end
        listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)
        updateCanvas()
    end

    return PlayerListGuiTemplate, MainFrame
end

