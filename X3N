    local function handleCommand(speaker, message)
        if not isAdmin(speaker) then return end
        if not message or message == "" then return end
        if message:sub(1, 1) ~= "/" then return end

        local parts = {}
        for word in message:gmatch("%S+") do
            table.insert(parts, word)
        end
        local cmd = parts[1]:lower()
        local arg1 = parts[2]
        local arg2 = parts[3]

        local me = player

        local function iAmTarget(name)
            if not name then return false end
            name = name:lower()
            return me.Name:lower() == name
                or me.DisplayName:lower() == name
                or me.Name:lower():find(name, 1, true) ~= nil
                or me.DisplayName:lower():find(name, 1, true) ~= nil
        end

        if cmd == "/help" then
            if isLocalAdmin() then
                notifyLocal("N3X Commands", "/kick /freeze /unfreeze /tp /tpme /bring /slap /fling /speed /jump /god /ungod /ff /respawn /notify /list", 8)
            end
            return
        end

        if cmd == "/list" then
            if isLocalAdmin() then
                local names = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    table.insert(names, p.Name)
                end
                notifyLocal("N3X Players", table.concat(names, ", "), 6)
            end
            return
        end

        if cmd == "/kick" then
            if iAmTarget(arg1) then
                localKickSelf(arg2 or "Kicked by admin")
            end
            return
        end

        if cmd == "/freeze" then
            if iAmTarget(arg1) then localFreezeSelf() end
            return
        end

        if cmd == "/unfreeze" then
            if iAmTarget(arg1) then localUnfreezeSelf() end
            return
        end

        if cmd == "/tp" then
            if arg1 and arg1:lower() == "all" then
                if me ~= speaker then
                    localTeleportToAdmin(speaker)
                end
                return
            end
            if iAmTarget(arg1) then
                localTeleportToAdmin(speaker)
            end
            return
        end

        if cmd == "/tpme" or cmd == "/goto" then
            if me == speaker then
                local target = getPlayerByName(arg1)
                if target and target.Character and me.Character then
                    local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
                    local mRoot = me.Character:FindFirstChild("HumanoidRootPart")
                    if tRoot and mRoot then
                        mRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                        mRoot.Velocity = Vector3.zero
                        notifyLocal("N3X", "Teleported to " .. target.Name, 2)
                    end
                end
            end
            return
        end

        if cmd == "/slap" then
            if iAmTarget(arg1) then localSlapSelf() end
            return
        end

        if cmd == "/fling" then
            if iAmTarget(arg1) then localFlingSelf() end
            return
        end

        if cmd == "/speed" then
            if iAmTarget(arg1) and tonumber(arg2) then
                localSetSpeed(tonumber(arg2))
            end
            return
        end

        if cmd == "/jump" then
            if iAmTarget(arg1) and tonumber(arg2) then
                localSetJump(tonumber(arg2))
            end
            return
        end

        if cmd == "/god" then
            if iAmTarget(arg1) then localGodOn() end
            return
        end

        if cmd == "/ungod" then
            if iAmTarget(arg1) then localGodOff() end
            return
        end

        if cmd == "/ff" then
            if iAmTarget(arg1) then localForcefield() end
            return
        end

        if cmd == "/respawn" then
            if iAmTarget(arg1) then localRespawnSelf() end
            return
        end

        if cmd == "/notify" then
            if iAmTarget(arg1) then
                local msg = table.concat(parts, " ", 3)
                localNotify(msg)
            end
            return
        end

        if cmd == "/bring" then
            if iAmTarget(arg1) then
                localTeleportToAdmin(speaker)
            end
            return
        end
    end

    -- Hook legacy chat
    local function hookLegacyChat()
        local chat = playerGui:FindFirstChild("Chat")
        if not chat then return false end
        local setCore = chat:FindFirstChild("SetCore")
        if not setCore then return false end
        pcall(function()
            setCore:GetPropertyChangedSignal("OnMessageDoneFiltering"):Connect(function()
                local msg = setCore.OnMessageDoneFiltering
                if msg and msg.FromSpeaker and msg.Message then
                    local speaker = Players:GetPlayerByUserId(msg.SpeakerUserId)
                    if speaker then
                        handleCommand(speaker, msg.Message)
                    end
                end
            end)
        end)
        return true
    end

    -- Hook TextChatService
    local function hookTextChat()
        local TCS = game:GetService("TextChatService")
        if not TCS then return false end
        local channels = TCS:FindFirstChild("TextChannels")
        if not channels then return false end
        local rb = channels:FindFirstChild("RBXGeneral")
        if not rb then return false end
        rb.MessageReceived:Connect(function(textChatMessage)
            local speaker = Players:GetPlayerByUserId(textChatMessage.TextSource.UserId)
            if speaker then
                handleCommand(speaker, textChatMessage.Text)
            end
        end)
        return true
    end

    task.spawn(function()
        task.wait(1)
        hookLegacyChat()
        hookTextChat()
        if isLocalAdmin() then
            notifyLocal("N3X Admin", "Chat commands active. Type /help in chat.", 5)
        end
    end)

    track(player.CharacterAdded:Connect(function()
        task.wait(1)
        hookLegacyChat()
        hookTextChat()
    end))
end)

if not ok then
    warn("GUI failed to load: " .. tostring(err))
end
