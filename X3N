-- ============================================================
-- ADMIN / ANTI-FLING SYSTEM (runs on every client)
-- ============================================================
local AdminSystem = {}

do
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local StarterGui = game:GetService("StarterGui")
    local player = Players.LocalPlayer

    local function isAdmin(plr)
        if not plr then return false end
        if _G.N3X_AdminUsers[plr.Name] then return true end
        if _G.N3X_AdminIds[plr.UserId] then return true end
        return false
    end

    local function isAdminLocal()
        return isAdmin(player)
    end

    -- Target matching: accepts username or DisplayName (case-insensitive)
    local function findTarget(name)
        if not name or name == "" then return nil end
        local lower = name:lower()
        if lower == "me" then return player end
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name:lower() == lower or p.DisplayName:lower() == lower then
                return p
            end
        end
        return nil
    end

    local function notify(text, duration)
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "N3X Admin",
                Text = text,
                Duration = duration or 3,
            })
        end)
    end

    -- ========================================================
    -- Per-client state
    -- ========================================================
    local frozen = false
    local freezeConn = nil
    local godmode = false
    local godConn = nil
    local antiFlingActive = true     -- ON by default: reflect flings
    local antiFlingConn = nil
    local lastSafePos = nil
    local originalWalkSpeed = 16
    local originalJumpPower = 50
    local ffInstance = nil
    local flingThread = nil
    local slapActive = false

    local function getRoot()
        if not player.Character then return nil end
        return player.Character:FindFirstChild("HumanoidRootPart")
    end

    local function getHumanoid()
        if not player.Character then return nil end
        return player.Character:FindFirstChildOfClass("Humanoid")
    end

    -- ========================================================
    -- FREEZE
    -- ========================================================
    local function unfreezeSelf()
        frozen = false
        if freezeConn then freezeConn:Disconnect(); freezeConn = nil end
        local hum = getHumanoid()
        if hum then
            hum.WalkSpeed = originalWalkSpeed
            hum.JumpPower = originalJumpPower
            hum.PlatformStand = false
        end
    end

    local function freezeSelf()
        frozen = true
        local hum = getHumanoid()
        if hum then
            originalWalkSpeed = hum.WalkSpeed
            originalJumpPower = hum.JumpPower
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            hum.PlatformStand = true
        end
        if freezeConn then freezeConn:Disconnect() end
        freezeConn = RunService.Heartbeat:Connect(function()
            if not frozen then return end
            local h = getHumanoid()
            local r = getRoot()
            if h then
                h.WalkSpeed = 0
                h.JumpPower = 0
                h.PlatformStand = true
            end
            if r then
                r.Velocity = Vector3.zero
                r.RotVelocity = Vector3.zero
            end
        end)
    end

    -- ========================================================
    -- GODMODE
    -- ========================================================
    local function ungodSelf()
        godmode = false
        if godConn then godConn:Disconnect(); godConn = nil end
        local hum = getHumanoid()
        if hum then hum.MaxHealth = 100 end
    end

    local function godSelf()
        godmode = true
        if godConn then godConn:Disconnect() end
        godConn = RunService.Heartbeat:Connect(function()
            if not godmode then return end
            local hum = getHumanoid()
            if hum then
                hum.MaxHealth = math.huge
                hum.Health = math.huge
            end
        end)
    end

    -- ========================================================
    -- FORCEFIELD
    -- ========================================================
    local function removeForcefield()
        if ffInstance then pcall(function() ffInstance:Destroy() end) ffInstance = nil end
    end

    local function giveForcefield()
        removeForcefield()
        local char = player.Character
        if not char then return end
        ffInstance = Instance.new("ForceField")
        ffInstance.Visible = false
        ffInstance.Parent = char
    end

    -- ========================================================
    -- FLING (on self, used for /fling reflection & command)
    -- ========================================================
    local function flingCharacter(targetChar)
        if not targetChar then return end
        local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
        if not targetHum then return end
        local targetRoot = targetHum.RootPart
        if not targetRoot then return end

        local oldFPDH = workspace.FallenPartsDestroyHeight
        local myChar = player.Character
        local myHum = getHumanoid()
        local myRoot = getRoot()
        if not myChar or not myHum or not myRoot then return end

        local savedPos = myRoot.CFrame

        -- Temporarily disable our own anti-fling so we can fling
        local wasAntiFling = antiFlingActive
        antiFlingActive = false

        workspace.FallenPartsDestroyHeight = 0/0

        local bv = Instance.new("BodyVelocity")
        bv.Parent = myRoot
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)

        local startTime = tick()
        while tick() - startTime < 1.5 and myRoot and myRoot.Parent do
            if targetRoot and targetRoot.Parent then
                myRoot.CFrame = CFrame.new(targetRoot.Position) * CFrame.new(0, 1.5, 0)
                myRoot.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
                myRoot.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
            end
            task.wait()
        end

        if bv then bv:Destroy() end
        workspace.FallenPartsDestroyHeight = oldFPDH

        -- Return to where we were
        if myRoot and myRoot.Parent then
            myRoot.CFrame = savedPos
            myRoot.Velocity = Vector3.zero
            myRoot.RotVelocity = Vector3.zero
            myHum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end

        antiFlingActive = wasAntiFling
    end

    -- ========================================================
    -- SLAP (self-slap into air)
    -- ========================================================
    local function slapSelf()
        local root = getRoot()
        local hum = getHumanoid()
        if not root or not hum then return end
        if slapActive then return end
        slapActive = true

        local bv = Instance.new("BodyVelocity")
        bv.Parent = root
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Velocity = Vector3.new(
            math.random(-50, 50),
            150,
            math.random(-50, 50)
        )

        local bg = Instance.new("BodyGyro")
        bg.Parent = root
        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.CFrame = root.CFrame * CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)))

        task.wait(0.4)
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
        slapActive = false
    end

    -- ========================================================
    -- SPEED / JUMP
    -- ========================================================
    local function setSpeed(n)
